#!/bin/sh
set -eu

# Publish the nine crates in dependency order, one level at a time.
# 按依赖顺序、一层一层地发布九个 crate。
#
# Why a script and not nine hand-typed commands: every dependent writes its
# internal requirement as a caret requirement on the current version line
# (`docs/roadmap-1.0.md` decision 1), so publishing `run_method` before the index
# serves `xirang-kernel` at that version fails resolution. The order below is that
# dependency chain, and the script waits for
# each level to appear in the index before starting the next one — the wait is
# the part a human forgets.
# 为什么要脚本而不是手敲九条命令：每个依赖方都把内部依赖写成对**当前版本线**的 caret 要求
# （`docs/roadmap-1.0.md` 决策 1），因此在 index 提供那一版的 `xirang-kernel` 之前发布
# `run_method` 会解析失败。下面的顺序就是那条依赖链，脚本会在开始下一层之前等待上一层出现
# 在 index 里——这个等待正是人容易忘掉的部分。
#
# Safety: the default mode is a dry run. Nothing is uploaded unless both
# `--publish` and `--yes` are given, because a published version is immutable on
# crates.io — it can only be yanked, never replaced.
# 安全：默认是 dry-run。只有同时给出 `--publish` 与 `--yes` 才会真的上传，因为 crates.io
# 上已发布的版本不可变——只能 yank，不能替换。
#
# Dry-run behaviour before the first release: a crate whose versioned
# `xirang-*` dependency is not on the index yet is *skipped with a warning*
# instead of failing, exactly like `tools/xirang-package-audit`. So today the
# dry run verifies `xirang-kernel` in full and reports the other eight as
# waiting; after core is published it verifies the next level, and so on.
# 首次发布之前的 dry-run 行为：带版本号的 `xirang-*` 依赖尚未出现在 index 上的 crate
# 会被**跳过并警告**，而不是失败，与 `tools/xirang-package-audit` 一致。因此今天 dry-run
# 会完整校验 `xirang-kernel`、把其余八个报成"等待中"；core 发布之后就会校验下一层，依此类推。
#
# Real publish:
#   CARGO_REGISTRY_TOKEN=... tools/xirang-publish --publish --yes
#   tools/xirang-publish --publish --yes --allow-dirty   # from a dirty tree
#
# The dependency table is hand-maintained, and a hand-maintained table goes
# stale silently; check it against the manifests before trusting the order:
#   tools/xirang-publish --check-table
# 依赖表是手工维护的，而手工维护的表会静默过期；在信任这个顺序之前先拿清单核对：
#   tools/xirang-publish --check-table
#
# Both modes above are checks: they upload nothing, and neither combines with
# `--publish` (that combination is refused rather than quietly doing nothing).
# 上面两个模式都是检查：不上传任何东西，也不与 `--publish` 组合（该组合会被直接拒绝，
# 而不是静默地什么都不做）。
#
# Print the release version this checkout names, read the same way the release reads it:
#   tools/xirang-publish --workspace-version
# The release workflow calls this instead of carrying its own copy of the reader, because
# two readers of one number diverge and the tag check is where a wrong answer is
# irreversible (audit RC4).
# It is a mode of its own: it prints the number and exits, so it combines with no other
# mode or flag — the combination exits 2 rather than skipping the other mode silently.
# 打印本检出点名的发布版本，读法与发布本身一致：
#   tools/xirang-publish --workspace-version
# 发布工作流调用它，而不是自带一份读取器副本——同一个数字的两个读取器会分歧，而 tag 检查正是
# "答错就不可逆"的地方（审计 RC4）。
# 它是独立模式：打印这个数字后即退出，因此不与任何其它模式或标志组合——组合会以 2 退出，而不是
# 静默跳过另一个模式。
#
# After it finishes, prove that a stranger can consume the release:
#   tools/xirang-publish --verify-consumers
# That builds a throwaway crate outside this checkout and `cargo add`s all nine
# crates by version, so resolution runs against the index rather than against the
# local paths. Packaging was verified before the upload; this is the half that
# only the published crates can answer.
# 发布完成后，证明陌生人能消费这个版本：
#   tools/xirang-publish --verify-consumers
# 它在本检出之外建一个一次性 crate，按版本 `cargo add` 九个 crate，因此解析发生在 index 上
# 而不是本地路径上。打包在上传前已经验证过；这一半只有已发布的 crate 才答得出来。
#
# The index probe below is deliberately duplicated from
# `tools/xirang-package-audit` rather than shared: both tools must stay
# runnable on their own from any directory (CI runs the audit, a maintainer runs
# this one), and the probe is the only thing they have in common.
# 下面的 index 探针刻意与 `tools/xirang-package-audit` 各留一份而不共用：两个工具都必须
# 能从任意目录独立运行（CI 跑审计，维护者跑本脚本），而探针是它们唯一共通的东西。

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

index_url="https://index.crates.io"
wait_seconds=${XIRANG_PUBLISH_WAIT:-300}

# One level per line, in dependency order. Crates on the same line are
# independent of each other.
# 每行一层，按依赖顺序。同一行内的 crate 互不依赖。
levels='
xirang-kernel
xirang-macro
xirang-multilang
xirang-toolchain
'

publish=false
yes=false
allow_dirty=false
verify_consumers=false
check_table=false
workspace_version_only=false
help_requested=false

for arg in "$@"; do
  case "$arg" in
    --publish) publish=true ;;
    --yes) yes=true ;;
    --allow-dirty) allow_dirty=true ;;
    --verify-consumers) verify_consumers=true ;;
    --check-table) check_table=true ;;
    --workspace-version) workspace_version_only=true ;;
    -h|--help) help_requested=true ;;
    *)
      echo "error: unknown argument '$arg' (see --help)" >&2
      exit 2
      ;;
  esac
done

# `--workspace-version` prints one number and exits 0 before any other mode runs,
# so combining it with one silently skipped that mode and still exited 0: with
# `--workspace-version --publish` nothing was uploaded while the run read as a
# finished release, and with `--workspace-version --check-table` the table was
# never checked. It is a mode of its own, so every combination is refused — `--help`
# included, which is why help is printed after this check rather than mid-parse.
# `--workspace-version` 只打印一个数字便以 0 退出，早于任何其它模式，因此与其它模式组合会
# 静默跳过那个模式却仍退出 0：`--workspace-version --publish` 什么都没上传，运行却会被读成
# "发布完成"；`--workspace-version --check-table` 则从未核对过那张表。它是独立模式，因此所有
# 组合都被拒绝——`--help` 也在内，这正是帮助改在此检查之后打印、而不是在解析途中打印的原因。
if [ "$workspace_version_only" = true ]; then
  if [ "$help_requested" = true ] ||
    [ "$publish" = true ] ||
    [ "$yes" = true ] ||
    [ "$allow_dirty" = true ] ||
    [ "$verify_consumers" = true ] ||
    [ "$check_table" = true ]; then
    echo "error: --workspace-version is a mode of its own; it does not combine with" \
      "--help, --publish, --yes, --allow-dirty, --check-table or --verify-consumers" >&2
    exit 2
  fi
fi

if [ "$help_requested" = true ]; then
  # Print the leading comment block: every `#` line, skipping the blank
  # line after `set -eu`, and stopping at the first line of code.
  # 打印文件开头的注释块：所有 `#` 行，跳过 `set -eu` 后的空行，遇到第一行代码即停。
  awk 'NR <= 2 { next } /^#/ { print; next } /^[[:space:]]*$/ { next } { exit }' "$0" |
    sed 's/^# \{0,1\}//'
  exit 0
fi

if [ "$publish" = true ] && [ "$yes" != true ]; then
  echo "error: --publish also needs --yes; publishing is irreversible" >&2
  exit 2
fi

# The two check modes exit on their own, so combining either with `--publish`
# would upload nothing and still exit 0 — a maintainer could read that as a
# finished release. Refuse the combination instead.
# 两个检查模式各自独立退出，因此任何一个与 `--publish` 组合都会什么都不上传却退出 0——
# 维护者可能把它读成"发布完成"。宁可拒绝这个组合。
if [ "$check_table" = true ] && [ "$verify_consumers" = true ]; then
  echo "error: --check-table and --verify-consumers are separate modes" >&2
  exit 2
fi
if [ "$publish" = true ] && { [ "$check_table" = true ] || [ "$verify_consumers" = true ]; }; then
  echo "error: --publish does not combine with --check-table or --verify-consumers" >&2
  exit 2
fi

if [ "$publish" = true ]; then
  if [ -z "${CARGO_REGISTRY_TOKEN:-}" ]; then
    # `cargo publish` can also read the token from ~/.cargo/credentials.toml, so
    # an unset variable is a warning rather than an error.
    # `cargo publish` 也能从 ~/.cargo/credentials.toml 读 token，因此变量未设置只是警告。
    echo "note: CARGO_REGISTRY_TOKEN is unset; Cargo will use its credentials file" >&2
  fi
  if [ "$allow_dirty" != true ] && [ -n "$(git status --porcelain)" ]; then
    echo "error: the working tree has uncommitted changes; commit them first," \
      "or pass --allow-dirty if the published content is exactly what you mean" >&2
    exit 1
  fi
fi

# Sparse-index path for a crate name: 1/<n>, 2/<n>, 3/<c>/<n>, else
# <first two>/<next two>/<n>.
# crate 名的 sparse index 路径：1/<n>、2/<n>、3/<c>/<n>，其余为
# <前两个字符>/<后两个字符>/<n>。
index_path() {
  name=$1
  length=${#name}
  if [ "$length" -eq 1 ]; then
    printf '1/%s' "$name"
  elif [ "$length" -eq 2 ]; then
    printf '2/%s' "$name"
  elif [ "$length" -eq 3 ]; then
    printf '3/%s/%s' "$(printf '%s' "$name" | cut -c1)" "$name"
  else
    printf '%s/%s/%s' \
      "$(printf '%s' "$name" | cut -c1-2)" \
      "$(printf '%s' "$name" | cut -c3-4)" \
      "$name"
  fi
}

# Whether one exact version is served by the index and still unyanked. The
# matched version's own JSON object must also say `"yanked":false`: a yanked
# version is still served by the index, but no new dependent can resolve it, so
# counting it as published reported a crate as `verified` that no consumer could
# actually use.
# 某个精确版本是否由 index 提供且仍未被撤回。匹配到的那个版本自己的 JSON 对象还必须写着
# `"yanked":false`：被撤回的版本仍由 index 提供，但新的依赖方已无法解析它，因此把它算作
# 已发布会把一个没有消费者用得上的 crate 报成 `verified`。
#
# A transport failure is not an answer from the registry. It is reported to
# stderr and exits non-zero here rather than being folded into "not published":
# against a dead endpoint the dry run used to print `verified: 1, skipped: 8` and
# exit 0, a claim nothing had actually asked the registry about. HTTP 404 keeps
# its meaning — the sparse index serves one file per crate, so a missing file is
# a real "no versions published" — and the retries below stay, so only a failure
# that outlives them stops the run.
# 传输失败不是 registry 给出的答案。这里把它报到 stderr 并以非零退出，而不是并进"未发布"：
# 面对一个死端点时，dry-run 过去会打印 `verified: 1, skipped: 8` 并以 0 退出——一个根本没向
# registry 问过的断言。HTTP 404 保持原意——sparse index 每个 crate 一个文件，文件缺失就是
# 真实的"没有发布过版本"——下面的重试保留，因此只有熬过重试的失败才会中止运行。
is_published() {
  name=$1
  version=$2
  path=$(index_path "$name")
  status=0
  if command -v curl >/dev/null 2>&1; then
    body=$(curl -fsS --max-time 20 --retry 3 --retry-connrefused --retry-delay 2 \
      "$index_url/$path" 2>/dev/null) || status=$?
    # curl exit 22 is "HTTP page not retrieved": the server answered with a
    # 4xx/5xx status. `--retry` already retried the 5xx statuses, so what
    # survives to here is the 404 that means "no such crate file"; every other
    # exit code is the request itself failing.
    # curl 退出码 22 是"未能取得 HTTP 页面"：服务端以 4xx/5xx 作答。`--retry` 已经重试过
    # 5xx，因此留到这里的是表示"没有该 crate 文件"的 404；其他退出码都是请求本身失败。
    if [ "$status" -ne 0 ] && [ "$status" -ne 22 ]; then
      printf 'error: cannot reach the index at %s (curl exit %s); refusing to report crates as unpublished from an unreachable registry\n' \
        "$index_url" "$status" >&2
      exit 1
    fi
  elif command -v wget >/dev/null 2>&1; then
    body=$(wget -q -O - --timeout=20 --tries=3 --waitretry=2 "$index_url/$path" 2>/dev/null) || status=$?
    # wget exit 8 is "server issued an error response" (the 404 above); every
    # other code is a network-level failure.
    # wget 退出码 8 是"服务端返回了错误响应"（即上面的 404）；其余都是网络层失败。
    if [ "$status" -ne 0 ] && [ "$status" -ne 8 ]; then
      printf 'error: cannot reach the index at %s (wget exit %s); refusing to report crates as unpublished from an unreachable registry\n' \
        "$index_url" "$status" >&2
      exit 1
    fi
  else
    printf 'error: neither curl nor wget is available; cannot probe the index at %s\n' "$index_url" >&2
    exit 1
  fi
  if [ "$status" -ne 0 ]; then
    return 1
  fi
  # One JSON object per version per line, so the second match tests the same
  # version's object rather than any object in the crate's file.
  # 每个版本每行一个 JSON 对象，因此第二次匹配检查的是同一个版本对象，而不是该 crate 文件里
  # 任意一个对象。
  printf '%s\n' "$body" |
    grep -F "\"vers\":\"$version\"" |
    grep -F '"yanked":false' >/dev/null 2>&1
}

# The workspace release version, read from `[workspace.package]` and nowhere else.
# A `version = "…"` line anywhere else in the root manifest — a centralized
# dependency requirement, say — used to be read as *the* release version: with such a
# line above `[workspace.package]` the tag step accepted `v0.1.0` and `--check-table`
# stayed green while every member, inheriting `0.1.1`, uploaded 0.1.1 — and the index
# wait then failed only *after* the irreversible upload.
# 工作区发布版本，只从 `[workspace.package]` 读取。根清单其他任何位置的一行 `version = "…"`
# ——比如集中写的依赖要求——过去会被读成**发布版本**：当这样一行位于 `[workspace.package]` 之前，
# tag 检查会接受 `v0.1.0`、`--check-table` 报绿，而每个成员继承 `0.1.1` 并上传 0.1.1，index
# 等待要到**不可逆上传之后**才失败。
workspace_version=$(awk '
  /^\[/ { section = $0; next }
  section == "[workspace.package]" && /^version *=/ {
    value = $0
    sub(/^version *= *"/, "", value)
    # The value ends at the closing quote, whatever follows it: a comment, a trailing space,
    # a CR. Stripping only a quote *at the end of the line* (the spelling this tool used to
    # carry) left `0.1.6" # pinned` as the version, while the release workflow carried its own
    # copy that stripped from the first quote and read it correctly — two readers of one
    # number disagreed, and the tag check is where a wrong answer cannot be undone (audit
    # RC4, measured on `version = "0.1.6" # pinned`).
    # 取值在闭引号处结束，无论其后是什么：注释、尾随空格、CR。只删**行尾**那个引号（本工具过去的
    # 拼法）会把 `0.1.6" # pinned` 当成版本，而发布工作流自带的那份从第一个引号起删、读得是对的——
    # 同一个数字的两个读取器分歧，而 tag 检查正是答错就无法挽回的地方（审计 RC4，实测于
    # `version = "0.1.6" # pinned`）。
    sub(/".*$/, "", value)
    gsub(/[[:space:]]+$/, "", value)
    print value
    exit
  }
' Cargo.toml)
if [ -z "$workspace_version" ]; then
  echo "error: [workspace.package] names no version in Cargo.toml" >&2
  exit 1
fi

# The release workflow asks this reader rather than carrying its own copy. Two readers of
# one number diverge: the workflow's copy stripped everything from the first quote
# (`sub(/".*$/, "", value)`) while this one strips only a trailing quote, so a line with
# anything after the closing quote produced two different versions — and the tag check is
# exactly where a wrong answer is irreversible (audit RC4).
# 发布工作流问这个读取器，而不是自带一份副本。同一个数字的两个读取器会分歧：工作流那份从第一个
# 引号起全删（`sub(/".*$/, "", value)`），而这里只删结尾的引号，因此闭引号之后还有内容的行会得出
# 两个不同版本——而 tag 检查恰恰是"答错就不可逆"的地方（审计 RC4）。
if [ "$workspace_version_only" = true ]; then
  printf '%s\n' "$workspace_version"
  exit 0
fi
if [ -z "$workspace_version" ]; then
  echo "error: could not read [workspace.package] version from Cargo.toml" >&2
  exit 1
fi

# The version `cargo publish` will actually package for one crate, asked of cargo rather
# than read from the manifest text. `version_problems` reads text and misses valid
# spellings, and `cargo pkgid` is the wrong source: it answers from the *lockfile*, which
# any earlier build in the release workflow has already refreshed to the new number.
# Measured on a mutant whose `macro/Cargo.toml` spells `version = '0.1.7'`:
# `cargo metadata --no-deps` says 0.1.7, `cargo pkgid` says 0.1.6, and `--check-table`
# stays green. The compact JSON is split with the same awk/sed idiom
# `tools/xirang-package-audit` already uses, so no JSON parser is added here.
# 某个 crate 会被 `cargo publish` 真正打包的版本，向 cargo 问，而不是读清单文本。
# `version_problems` 读文本，会漏掉合法拼写；而 `cargo pkgid` 是错的来源：它按 **lockfile**
# 作答，而发布工作流里更早的构建已经把它刷成了新数字。在一个把 `macro/Cargo.toml` 写成
# `version = '0.1.7'` 的变异体上实测：`cargo metadata --no-deps` 说 0.1.7，`cargo pkgid`
# 说 0.1.6，而 `--check-table` 仍是绿的。紧凑 JSON 用 `tools/xirang-package-audit` 已在用的
# 同一套 awk/sed 惯例切分，因此这里没有引入 JSON 解析器。
metadata_snapshot=$(cargo metadata --no-deps --format-version 1 2>/dev/null || true)
resolved_version() {
  printf '%s' "$metadata_snapshot" |
    tr '{' '\n' |
    grep -m1 "\"name\":\"$1\",\"version\":" |
    sed 's/.*"version":"\([^"]*\)".*/\1/'
}

# "<crate>:<space-separated versioned xirang-* dependencies>"
# "<crate>:<以空格分隔的带版本号 xirang-* 依赖>"
dependencies='
xirang-kernel:
xirang-macro:xirang-kernel
xirang-multilang:xirang-kernel
xirang-toolchain:xirang-kernel xirang-macro xirang-multilang
'

# The internal dependencies of one crate, read from the table above.
# The internal dependencies of one crate, read from the table above as whole
# lines. Reading it word-wise would hand back an edge line's dependencies as
# entries of their own, and stopping at the first word would drop every
# dependency after the first — which is what let `xirang-cli` look publishable
# while `xirang-mcp` and `xirang-studio` were still missing from the index.
# 读取上表中某个 crate 的内部依赖，按整行读取。按词读取会把一条边行的被依赖者当成独立条目，
# 而在第一个词处停下会丢掉第一个之后的每个依赖——正是这一点让 `xirang-cli` 在
# `xirang-mcp` 与 `xirang-studio` 尚未进入 index 时看起来可以发布。
deps_of() {
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    case "$entry" in
      "$1":*) printf '%s' "${entry#"$1":}"; return 0 ;;
    esac
  done <<EOF
$dependencies
EOF
  return 1
}

# `cargo publish` flags that do not depend on the mode.
cargo_flags="--locked"
if [ "$allow_dirty" = true ] || [ "$publish" != true ]; then
  # A dry run verifies packaging, not provenance; a dirty tree is the normal
  # state while preparing a release.
  # dry-run 校验的是打包而不是来源；准备发布期间工作区通常就是脏的。
  cargo_flags="$cargo_flags --allow-dirty"
fi

# Every crate in the dependency table, in the table's own order, one name per
# line: reading the table as words instead of as lines would hand back an edge
# line's dependencies as if they were crates of their own.
# 依赖表里的每个 crate，按表内顺序，每行一个名字：按词而不是按行读取，会把一条边行的
# 被依赖者当成独立 crate 交出来。
all_crates=$(
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    printf '%s\n' "${entry%%:*}"
  done <<EOF
$dependencies
EOF
)
# Prove that a crate outside this checkout can resolve the release from the
# index. This is the verification a dry run cannot do: packaging reads local
# paths, and only a consumer reads the published requirements.
# 证明本检出之外的一个 crate 能从 index 解析这次发布。这是 dry-run 做不到的验证：打包读的是
# 本地路径，只有消费者读的是已发布的要求。
if [ "$verify_consumers" = true ]; then
  directory=$(mktemp -d)
  trap 'rm -rf "$directory"' EXIT INT TERM
  consumer="$directory/consumer"
  # `--vcs none`: this is a throwaway crate, and nothing here should run `git`.
  # `--vcs none`：这是一次性 crate，这里任何东西都不该去动 `git`。
  if ! cargo new --lib --quiet --vcs none "$consumer" 2>/dev/null; then
    echo "error: cannot create a throwaway crate in $directory" >&2
    exit 1
  fi
  resolved=""
  unresolved=""
  for crate in $all_crates; do
    if (cd "$consumer" && cargo add "$crate@$workspace_version" --quiet >/dev/null 2>&1); then
      resolved="$resolved $crate"
    else
      unresolved="$unresolved $crate"
    fi
  done
  if [ -n "$unresolved" ]; then
    cat >&2 <<EOF
error: the index does not serve this version for: ${unresolved# }
Nothing is wrong with the checkout: those crates are not published yet, or the
