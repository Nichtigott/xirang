# Running the tools
# ---------------------------------------------------------------------------------------------


def run(command, cwd=None, timeout=300):
    started = time.perf_counter()
    try:
        completed = subprocess.run(
            command, cwd=cwd, text=True, capture_output=True, timeout=timeout
        )
        return {
            "command": [str(part) for part in command],
            "seconds": round(time.perf_counter() - started, 3),
            "exit": completed.returncode,
            "stdout": completed.stdout,
            "stderr": completed.stderr,
        }
    except subprocess.TimeoutExpired:
        return {
            "command": [str(part) for part in command],
            "seconds": round(time.perf_counter() - started, 3),
            "exit": "timeout",
            "stdout": "",
            "stderr": f"timed out after {timeout}s",
        }


def xirang_answer(root, names):
    payload = json.dumps({"function": names})
    return run([str(MCP), "--call", "callgraph", "--json", payload, "--root", str(root)])


def build_mcp():
    """Build the binary this matrix scores, with both language providers compiled in."""
    return run(
        [
            "cargo",
            "build",
            "-p",
            "xirang-toolchain",
            "--features",
            "mcp,lang-cpp,lang-python",
            "--offline",
            "--bin",
            "xirang-mcp",
        ],
        cwd=ROOT,
        timeout=900,
    )


def missing_language_providers():
    """Which of C++/Python this binary cannot report facts for, by asking it about a probe file.

    The matrix scores 6 C++ and 4 Python cases. A binary built without `lang-cpp`/`lang-python`
    answers "no static function match" for those files — which looks exactly like a product recall
    of 0, and that is how one run scored 6/14 instead of 14/14: any `cargo test -p xirang-toolchain
    --features mcp` rebuilds `target/debug/xirang-mcp` with only the `mcp` feature, silently
    replacing a feature-complete binary. Probing here turns that setup defect into a refusal.
    """
    root = pathlib.Path(tempfile.mkdtemp(prefix="xirang-callgraph-probe-"))
    try:
        (root / "probe.cpp").write_text("void cpp_probe() {}\n")
        (root / "probe.py").write_text("def py_probe():\n    return 1\n")
        missing = []
        for language, name in (("lang-cpp", "cpp_probe"), ("lang-python", "py_probe")):
            answer = xirang_answer(root, [name])
            # A *definition row* is the signal, not the bare name: a build without the provider
            # still echoes the queried name in "no static function match for `cpp_probe`", so a
            # substring test would pass on exactly the defect this probe exists to catch.
            # 信号是**定义行**，不是裸名字：没有该 provider 的构建也会在 "no static function match
            # for `cpp_probe`" 里回显被查询的名字，用子串判定恰好会放过这个探针要抓的缺陷。
            if f"fn {name}" not in answer["stdout"]:
                missing.append(language)
        return missing
    finally:
        shutil.rmtree(root, ignore_errors=True)


def codegraph_setup(root):
    return run([str(CG), "init", "-y", str(root)])


def codegraph_query(root, mode, symbol):
    return run([str(CG), mode, symbol, "--path", str(root), "-j"])


