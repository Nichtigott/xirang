DEFINITION = re.compile(r"^(?P<file>[^:\s][^:]*):(?P<line>\d+) fn (?P<qualified>.+)$")


def split_top_level(text):
    """Split a comma-separated list, keeping commas inside parentheses together."""
    parts, depth, current = [], 0, []
    for character in text:
        if character == "(":
            depth += 1
        elif character == ")":
            depth = max(0, depth - 1)
        if character == "," and depth == 0:
            parts.append("".join(current).strip())
            current = []
            continue
        current.append(character)
    if current:
        parts.append("".join(current).strip())
    return [part for part in parts if part]


def parse_xirang(text):
    """One block per answered definition: its qualified name, line, callers, callees, unknowns."""
    blocks, current = [], None
    for line in text.splitlines():
        if line.startswith("evidence: "):
            current = None
            continue
        header = DEFINITION.match(line)
        if header:
            current = {
                "file": header.group("file"),
                "line": int(header.group("line")),
                "qualified": header.group("qualified").strip(),
                "callers": [],
                "callees": [],
                "unresolved": [],
            }
            blocks.append(current)
            continue
        if current is None:
            continue
        stripped = line.strip()
        if stripped.startswith("callers ("):
            body = stripped.split(":", 1)[1].strip() if ":" in stripped else ""
            if body and body != "-":
                current["callers"] = split_top_level(body)
        elif stripped.startswith("unresolved: ") and len(stripped) > len("unresolved: "):
            current["unresolved"] = split_top_level(stripped[len("unresolved: ") :])
        elif stripped.startswith("callees: "):
            current["callees"] = split_top_level(stripped[len("callees: ") :])
    return blocks


def caller_name(printed):
    """`src/lib.rs::Fast::run` -> `Fast::run`; a bare `caller` stays `caller`."""
    _, _, rest = printed.partition("::")
    return rest if rest else printed


def xirang_claims(blocks):
    claims = set()
    for block in blocks:
        for caller in block["callers"]:
            claims.add((caller_name(caller), block["qualified"]))
        for callee in block["callees"]:
            if " -> " not in callee:
                continue
            target, location = callee.split(" -> ", 1)
            if location.startswith("ambiguous") or ":" not in location:
                continue
            claims.add((block["qualified"], target.strip()))
    return claims


def xirang_candidate_text(blocks, caller_qualified):
    lines = []
    for block in blocks:
        if block["qualified"] == caller_qualified:
            lines.extend(block["unresolved"])
    return "\n".join(lines)


# ---------------------------------------------------------------------------------------------
# Parsing CodeGraph's JSON answers
# ---------------------------------------------------------------------------------------------


def load_json(reply):
    try:
        return json.loads(reply["stdout"])
    except (json.JSONDecodeError, TypeError):
        return None


def codegraph_symbols(case):
    """(file, line) -> the qualified names the fixture declares at that position.

    A template pattern and its implicit instantiation share one source line, so the value is a
    *set*: a bare `file:line` entry from a side that does not name template arguments can then be
    read as the ambiguous thing it is instead of being silently canonicalised onto one of them.
    """
    symbols = {}
    for qualified, file, line in case["defs"]:
        symbols.setdefault((file, line), set()).add(qualified)
    return symbols


def codegraph_claims(callers_payload, callees_payload, symbols):
    """Direct call edges, canonicalised through the fixture's definition table.

    `relationships` separates a call from a reference, and `metadata.synthesizedBy` marks a
    dispatch edge attached to an interface declaration rather than to a call site: that one is
    returned separately as `synthetic` and is not scored.
    """
    claims, synthetic = set(), set()

    def canonical(entry):
        key = (entry.get("filePath"), entry.get("startLine"))
        declared = symbols.get(key) or set()
        if len(declared) == 1:
            return next(iter(declared))
        return entry.get("qualifiedName") or entry.get("name") or ""

    for payload, direction in ((callers_payload, "callers"), (callees_payload, "callees")):
        if not payload:
            continue
        for definition in payload.get("definitions") or []:
            owner = canonical(definition.get("definition") or {})
            if not owner:
                continue
            edge_metadata = {}
            for edge in definition.get("edges") or []:
                if edge.get("kind") != "calls":
                    continue
                other = edge.get("source") if direction == "callers" else edge.get("target")
                edge_metadata[other] = edge.get("metadata") or {}
            for entry in definition.get(direction) or []:
                if "calls" not in (entry.get("relationships") or []):
                    continue
                name = canonical(entry)
                if not name:
                    continue
                metadata = edge_metadata.get(entry.get("id")) or {}
                pair = (name, owner) if direction == "callers" else (owner, name)
                if metadata.get("synthesizedBy"):
                    synthetic.add(pair)
                else:
                    claims.add(pair)
    return claims, synthetic


def codegraph_candidate_text(callees_payload, caller_qualified, symbols):
    entries = []
    if not callees_payload:
        return ""
    for definition in callees_payload.get("definitions") or []:
        declared = definition.get("definition") or {}
        key = (declared.get("filePath"), declared.get("startLine"))
        names = symbols.get(key) or set()
        owner = next(iter(names)) if len(names) == 1 else (
            declared.get("qualifiedName") or declared.get("name")
        )
        if owner != caller_qualified:
            continue
        for callee in definition.get("callees") or []:
            if "calls" not in (callee.get("relationships") or []):
                continue
            names = symbols.get((callee.get("filePath"), callee.get("startLine"))) or set()
            entries.append(
                next(iter(names)) if len(names) == 1 else (callee.get("name") or "")
            )
    return "\n".join(entry for entry in entries if entry)


def codegraph_definitions(payloads, symbols):
    rows = []
    for payload in payloads:
        if not payload:
            continue
        sources = list(payload.get("targets") or [])
        sources += [
            definition.get("definition") or {}
            for definition in payload.get("definitions") or []
        ]
        for source in sources:
            key = (source.get("filePath"), source.get("startLine"))
            names = symbols.get(key) or set()
            declared = sorted(names) if names else [
                source.get("qualifiedName") or source.get("name")
            ]
            if key[1] is not None:
                for qualified in declared:
                    if qualified:
                        rows.append(
                            {"qualified": qualified, "file": key[0], "line": key[1]}
                        )
    return rows


# ---------------------------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------------------------


def matches(printed, truth):
    """Whether a printed name denotes exactly this truth symbol.

    A printed name may carry a module path the truth does not (`a::Entry::make` for `Entry::make`):
    a module path is not part of the identity this matrix asks about. The reverse is not accepted —
    a bare `run` does not name `Fast::run`. When several truth symbols end with the printed name,
    the answer named one of them without saying which; that is recorded as `ambiguous`, which is
    imprecision, not a false certainty.
    """
    return printed == truth or printed.endswith("::" + truth)


def named_candidates(printed, considered):
    """Truth symbols a printed name could denote: exact, module-prefixed, or a suffix of them."""
    return {
        name
        for name in considered
        if matches(printed, name) or name.endswith("::" + printed)
    }


def covered_by_queries(qualified, case):
    """Whether the queries this case issues can reach this definition row at all."""
    for query in (case["ask_callee"], case["ask_caller"]):
        if not query:
            continue
        if matches(qualified, query):
            return True
        leaf = query.split("<")[0]
        if qualified.startswith(leaf + "<") or qualified.startswith(query + "::"):
            return True
    return False


def score_side(claims, candidate_text, definition_rows, case):
    claim = list(case["claim"])
    forbid = list(case["forbid"])
    mention = case["mention"]

    considered = {callee for _, callee in claim} | {callee for _, callee in forbid}
    considered |= set(mention)

    hits = set()
    forbidden_hits = set()
    ambiguous = set()
    relevant = set()
    for caller, callee in claims:
        named = named_candidates(callee, considered)
        if not named:
            continue
        relevant.add((caller, callee))
        if len(named) > 1 or not matches(callee, next(iter(named))):
            # The answer named a symbol under test without saying which one: one of two namespaces,
            # or a bare leaf for a qualified owner. Imprecise, but not a false certainty.
            ambiguous.add((caller, callee))
            continue
        name = next(iter(named))
        hit = [(c, d) for c, d in claim if matches(caller, c) and matches(name, d)]
        fault = [(c, d) for c, d in forbid if matches(caller, c) and matches(name, d)]
        if hit and not fault:
            hits.add((hit[0][0], hit[0][1]))
        elif fault:
            forbidden_hits.add((fault[0][0], fault[0][1]))

    recall = len(hits) / len(claim) if claim else None
    precision = len(hits) / len(relevant) if relevant else None
    # Only a case whose call site genuinely has no static target measures unknown-rate honesty;
    # a `forbid` entry in an identity case (two owners, two namespaces, two overloads) is a
    # precision trap, not an unknown call.
    unknown_rate = None
    if case.get("unknown_site"):
        unknown_rate = 0.0 if forbidden_hits else 1.0
    candidate_recall = None
    if mention:
        named_count = sum(1 for name in mention if name in candidate_text)
        candidate_recall = named_count / len(mention)

    found = []
    for qualified, file, line in case["find"]:
        covered = covered_by_queries(qualified, case)
        ok = any(
            row["qualified"] == qualified
            and row["line"] == line
            and (row.get("file") or "").endswith(file)
            for row in definition_rows
        )
        found.append(
            {
                "qualified": qualified,
                "file": file,
                "line": line,
                "covered": covered,
                "ok": ok if covered else None,
            }
        )

    return {
        "claims": sorted(f"{c} -> {d}" for c, d in claims),
        "hits": sorted(f"{c} -> {d}" for c, d in hits),
        "forbidden": sorted(f"{c} -> {d}" for c, d in forbidden_hits),
        "ambiguous": sorted(f"{c} -> {d}" for c, d in ambiguous),
        "recall": recall,
        "precision": precision,
        "unknown_rate": unknown_rate,
        "candidate_recall": candidate_recall,
        "must_find": found,
    }


# ---------------------------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------------------------


def prepare(case, work):
    root = work / case["name"]
    for relative, source in case["files"].items():
        path = root / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(source, encoding="utf-8")
    return root


def run_case(case, work):
    root = prepare(case, work)
    names = [name for name in (case["ask_callee"], case["ask_caller"]) if name]
    symbols = codegraph_symbols(case)
    started = time.perf_counter()

    xirang = xirang_answer(root, names)
    xirang_blocks = parse_xirang(xirang["stdout"] + xirang["stderr"])
    xirang_score = score_side(
        xirang_claims(xirang_blocks),
        xirang_candidate_text(xirang_blocks, case["ask_caller"]),
        xirang_blocks,
        case,
    )

    setup = codegraph_setup(root)
    queries, callers_payload, callees_payload = [], None, None
    if case["ask_callee"]:
        reply = codegraph_query(root, "callers", case["ask_callee"])
        queries.append(reply)
        callers_payload = load_json(reply)
    if case["ask_caller"]:
        reply = codegraph_query(root, "callees", case["ask_caller"])
        queries.append(reply)
        callees_payload = load_json(reply)
    codegraph_claim_set, synthetic = codegraph_claims(
        callers_payload, callees_payload, symbols
    )
    codegraph_score = score_side(
        codegraph_claim_set,
        codegraph_candidate_text(callees_payload, case["ask_caller"], symbols),
        codegraph_definitions((callers_payload, callees_payload), symbols),
        case,
    )

    return {
        "case": case["name"],
        "lang": case["lang"],
        "note": case["note"],
        "truth": {
            "claim": [f"{c} -> {d}" for c, d in case["claim"]],
            "forbid": [f"{c} -> {d}" for c, d in case["forbid"]],
            "mention": case["mention"],
            "find": [f"{q} @ {f}:{l}" for q, f, l in case["find"]],
            "defs": [f"{q} @ {f}:{l}" for q, f, l in case["defs"]],
        },
        "xirang": {
            "steps": {"steps": 1, "seconds": xirang["seconds"], "exit": xirang["exit"]},
            "bytes": len(xirang["stdout"].encode()),
            "answer_head": [
                line
                for line in (xirang["stdout"] + xirang["stderr"]).splitlines()
                if line.strip() and not line.startswith("    ")
            ][:12],
            **xirang_score,
        },
        "codegraph": {
            "steps": {
                "steps": len(queries),
                "setup_steps": 1,
                "setup_seconds": setup["seconds"],
                "seconds": round(sum(query["seconds"] for query in queries), 3),
                "exit": [query["exit"] for query in queries],
            },
            "bytes": sum(len(query["stdout"].encode()) for query in queries),
            "synthetic": sorted(f"{c} => {d}" for c, d in synthetic),
            "answer_head": (
                [
                    f"def {row['qualified']} @ {row['file']}:{row['line']}"
                    for row in codegraph_definitions(
                        (callers_payload, callees_payload), symbols
                    )
                ]
                + [f"edge {c} -> {d}" for c, d in sorted(codegraph_claim_set)]
                + [f"synthetic {c} => {d}" for c, d in sorted(synthetic)]
            )[:12],
            **codegraph_score,
        },
        "seconds": round(time.perf_counter() - started, 3),
    }


def percent(value):
    return "  n/a " if value is None else f"{value:5.0%}"


def summarise(rows):
    headers = (
        f"{'case':24} {'lang':7} {'xr rec':7} {'xr prec':7} {'xr forbid':9} "
        f"{'xr cand':7} {'xr unk':7} {'xr step':7} {'cg rec':7} {'cg prec':7} "
        f"{'cg forbid':9} {'cg cand':7} {'cg unk':7} {'cg step':7}"
    )
    print(headers)
    print("-" * len(headers))
    totals = {
        "truth_edges": 0,
        "xirang_hits": 0,
        "xirang_forbid": 0,
        "codegraph_hits": 0,
        "codegraph_forbid": 0,
        "xirang_steps": 0,
        "codegraph_steps": 0,
        "codegraph_setup_steps": 0,
        "xirang_bytes": 0,
        "codegraph_bytes": 0,
        "xirang_seconds": 0.0,
        "codegraph_seconds": 0.0,
        "xirang_unknown_cases": 0,
        "xirang_unknown_clean": 0,
        "codegraph_unknown_cases": 0,
        "codegraph_unknown_clean": 0,
        "xirang_must_find": 0,
        "xirang_must_find_ok": 0,
        "codegraph_must_find": 0,
        "codegraph_must_find_ok": 0,
        "xirang_claim_count": 0,
        "codegraph_claim_count": 0,
    }
    for row in rows:
        xr, cg = row["xirang"], row["codegraph"]
        print(
            f"{row['case']:24} {row['lang']:7} {percent(xr['recall']):>7} "
            f"{percent(xr['precision']):>7} {len(xr['forbidden']):>9} "
            f"{percent(xr['candidate_recall']):>7} {percent(xr['unknown_rate']):>7} "
            f"{xr['steps']['steps']:>7} "
            f"{percent(cg['recall']):>7} {percent(cg['precision']):>7} "
            f"{len(cg['forbidden']):>9} {percent(cg['candidate_recall']):>7} "
            f"{percent(cg['unknown_rate']):>7} {cg['steps']['steps']:>7}"
        )
        for side, prefix in ((xr, "xirang"), (cg, "codegraph")):
            totals[f"{prefix}_hits"] += len(side["hits"])
            totals[f"{prefix}_forbid"] += len(side["forbidden"])
            totals[f"{prefix}_claim_count"] += len(side["claims"])
            totals[f"{prefix}_steps"] += side["steps"]["steps"]
            totals[f"{prefix}_bytes"] += side["bytes"]
            totals[f"{prefix}_seconds"] += side["steps"]["seconds"]
            if side["unknown_rate"] is not None:
                totals[f"{prefix}_unknown_cases"] += 1
                totals[f"{prefix}_unknown_clean"] += 1 if side["unknown_rate"] == 1.0 else 0
            for row_found in side["must_find"]:
                if row_found["ok"] is None:
                    continue
                totals[f"{prefix}_must_find"] += 1
                totals[f"{prefix}_must_find_ok"] += 1 if row_found["ok"] else 0
        totals["truth_edges"] += len(row["truth"]["claim"])
        totals["codegraph_setup_steps"] += 1
    print()
    print(
        f"truth edges: {totals['truth_edges']} · "
        f"XiRang: hits {totals['xirang_hits']} / claims {totals['xirang_claim_count']} · "
        f"forbidden {totals['xirang_forbid']} · "
        f"unknown-clean {totals['xirang_unknown_clean']}/{totals['xirang_unknown_cases']} · "
        f"must-find {totals['xirang_must_find_ok']}/{totals['xirang_must_find']} · "
        f"steps {totals['xirang_steps']} · bytes {totals['xirang_bytes']}"
    )
    print(
        f"CodeGraph: hits {totals['codegraph_hits']} / claims {totals['codegraph_claim_count']} · "
        f"forbidden {totals['codegraph_forbid']} · "
        f"unknown-clean {totals['codegraph_unknown_clean']}/{totals['codegraph_unknown_cases']} · "
        f"must-find {totals['codegraph_must_find_ok']}/{totals['codegraph_must_find']} · "
        f"query steps {totals['codegraph_steps']} "
        f"(+{totals['codegraph_setup_steps']} index builds) · bytes {totals['codegraph_bytes']}"
    )
    return totals


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--json-out", type=pathlib.Path, default=None)
    parser.add_argument("--strict", action="store_true")
    parser.add_argument("--only", default=None, help="comma-separated case names")
    parser.add_argument("--keep", action="store_true", help="keep the fixture tree")
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="use the existing binary (still probed for both language providers)",
    )
    parser.add_argument(
        "--mcp-binary",
        type=pathlib.Path,
        default=None,
        help="score this binary instead of building one",
    )
    arguments = parser.parse_args()

    global MCP
    if arguments.mcp_binary is not None:
        MCP = arguments.mcp_binary
    elif not arguments.no_build:
        built = build_mcp()
        if built["exit"] != 0:
            print(
                "the matrix could not build the binary it scores:\n"
                + "".join(built["stderr"].splitlines(keepends=True)[-20:]),
                file=sys.stderr,
            )
            return 2
    if not MCP.is_file():
        print(
            f"missing {MCP}; build it first "
            "(cargo build -p xirang-toolchain --features mcp,lang-cpp,lang-python --bin xirang-mcp)",
            file=sys.stderr,
        )
        return 2
    missing = missing_language_providers()
    if missing:
        print(
            f"the binary at {MCP} reports no facts for {', '.join(missing)} — the matrix scores "
            "those languages, so a silent 0 here is a setup defect, not a product result;\n"
            "rebuild it with `cargo build -p xirang-toolchain --features mcp,lang-cpp,lang-python "
            "--bin xirang-mcp`, or pass --mcp-binary pointing at such a build",
            file=sys.stderr,
        )
        return 2
    if not CG.is_file():
        print(f"missing codegraph at {CG}; set CODEGRAPH_BIN", file=sys.stderr)
        return 2

    selected = CASES
    if arguments.only:
        wanted = {name.strip() for name in arguments.only.split(",") if name.strip()}
        selected = [case for case in CASES if case["name"] in wanted]
        if not selected:
            print(f"no case named in {sorted(wanted)}", file=sys.stderr)
            return 2

    work = pathlib.Path(tempfile.mkdtemp(prefix="xirang-callgraph-matrix-"))
    rows = []
    for case in selected:
        rows.append(run_case(case, work))
        print(f"ran {case['name']}", file=sys.stderr)

    totals = summarise(rows)
    report = {
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "work": str(work),
        "fixtures_retained": bool(arguments.keep),
        "binaries": {
            "xirang_mcp": {
                "path": str(MCP),
                "sha256": hashlib.sha256(MCP.read_bytes()).hexdigest(),
            },
            "codegraph": {
                "path": str(CG),
                "sha256": hashlib.sha256(CG.read_bytes()).hexdigest(),
            },
        },
        "reading": {
            "kind": "deterministic tool-output comparison; no model session, no token claim",
            "recall": "fraction of the case's true definite edges stated by the answer",
            "precision": "hits / claims about the case's asked-about symbols; other callees are not scored",
            "forbidden": "claims the language semantics do not support; counted separately from a miss",
            "unknown": "of the case's statically unknown call sites, the fraction with no forbidden claim",
            "candidates": "fraction of true candidate implementations named where the answer resolves the unknown call",
            "must_find": "definition rows the answer must contain, for rows the issued queries cover",
            "steps": "tool invocations for the case's question set; indexing is setup, not a query step",
            "bytes": "stdout bytes of those invocations; a context-cost proxy, not a token count",
        },
        "totals": totals,
        "cases": rows,
    }
    if arguments.json_out:
        arguments.json_out.parent.mkdir(parents=True, exist_ok=True)
        arguments.json_out.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n")
        print(f"json: {arguments.json_out}")
    print(f"fixtures: {work}")

    failures = []
    for row in rows:
        side = row["xirang"]
        if side["forbidden"]:
            failures.append(f"{row['case']}: XiRang claimed forbidden {side['forbidden']}")
        if row["truth"]["claim"] and (side["recall"] or 0) < 1.0:
            message = (
                f"{row['case']}: XiRang recall {side['recall']} over {row['truth']['claim']}"
            )
            if case_note := next(
                (
                    candidate.get("known_gap")
                    for candidate in CASES
                    if candidate["name"] == row["case"]
                ),
                None,
            ):
                print(f"known gap: {message} — {case_note}")
            else:
                failures.append(message)
        for found in side["must_find"]:
            if found["ok"] is False:
                failures.append(
                    f"{row['case']}: XiRang did not report {found['qualified']} at "
                    f"{found['file']}:{found['line']}"
                )
    if failures:
        print("\nstrict findings (XiRang):")
        for failure in failures:
            print(f"  {failure}")
    if not arguments.keep:
        shutil.rmtree(work, ignore_errors=True)
    if arguments.strict and failures:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
