def partition_leg(work, cli, mcp_binary):
    """The same move and partition, in both orders, compared on the built tree.

    同一个 move 与同一个分区，按两种顺序执行，比较构建出的树。
    """
    print("== leg partition (same move/partition in both orders)")
    facts = {}
    for order in ("move-first", "partition-first"):
        host, graft = partition_copy(work, order)
        before_third_party = source_hashes(graft)
        mcp = MCP(mcp_binary, host, namespace="xirang-example-control-button")
        try:
            if order == "move-first":
                apply(mcp, host, action="move", apply=True, node="root/control/button",
                      to="root", rebind_grafts=True)
                run([str(cli), "check"], cwd=host)
                apply_declaration(mcp, host, "objects", "crate::control::SUBTREE")
                run([str(cli), "crates", "--write"], cwd=host)
            else:
                run([str(cli), "check"], cwd=host)
                apply_declaration(mcp, host, "objects", "crate::control::SUBTREE")
                run([str(cli), "crates", "--write"], cwd=host)
                apply(mcp, host, action="move", apply=True, node="root/control/button",
                      to="root", rebind_grafts=True)
                run([str(cli), "check"], cwd=host)
                run([str(cli), "crates", "--write"], cwd=host)
            build = cargo(host, "build", "--workspace")
            if "Finished" not in build:
                fail("partition/%s: workspace build failed:\n%s" % (order, build[-3000:]))
            (host / "crates/xirang-example-control-button-facade/tests").mkdir(parents=True,
                                                                                  exist_ok=True)
            (host / "crates/xirang-example-control-button-facade/tests/gate_partition.rs").write_text(
                PARTITION_TEST)
            output = cargo(host, "test", "-p", "xirang-example-control-button-facade",
                           "--test", "gate_partition")
            if "test result: ok" not in output:
                fail("partition/%s: runtime assertions failed:\n%s" % (order, output[-4000:]))
            after_third_party = source_hashes(graft)
            if after_third_party != before_third_party:
                fail("partition/%s: the third-party crate changed" % order)
            # A move rooted at the **generated** package must be refused before writing: its bytes
            # are regenerated from the host, so accepting it would silently lose the edit.
            # 以**生成包**为根的 move 必须在写入前拒绝：它的字节会从宿主重生成，接受它等于静默丢掉修改。
            generated = host / "crates/xirang-example-control-button-objects"
            before = source_hashes(generated)
            bad = MCP(mcp_binary, generated, namespace="xirang-example-control-button")
            try:
                refusal = bad.tool("xirang.apply", generated, action="move", apply=True,
                                   node="root/control/slider", to="root")
            finally:
                bad.close()
            if not refusal["isError"] or "generated partition package" not in refusal["text"]:
                fail("partition/%s: a move inside a generated package was not refused:\n%s"
                     % (order, refusal["text"]))
            if source_hashes(generated) != before or (generated / ".xirang/moves").exists():
                fail("partition/%s: the refused generated-package move changed files or wrote a record"
                     % order)
            registry = mcp.tool("xirang.registry", host, full=True)
            facts[order] = registry_facts(registry["text"])
        finally:
            mcp.close()
    if facts["move-first"] != facts["partition-first"]:
        fail("partition: the two orders report different trees:\n--- move-first\n%s\n--- "
             "partition-first\n%s" % (facts["move-first"], facts["partition-first"]))
    print("   both orders built; same tree, identities, graft endpoints, third-party bytes")


def registry_facts(text):
    """The face rows of one registry answer, independent of freshness and fingerprint lines."""
    facts = []
    for line in text.splitlines():
        if "logical_path=root" not in line:
            continue
        fields = {}
        for token in line.split():
            if "=" in token:
                key, value = token.split("=", 1)
                fields[key] = value
        parts = line.split()
        facts.append((fields.get("logical_path"), fields.get("kind"), parts[2] if len(parts) > 2 else "",
                      fields.get("parent"), parts[1] if len(parts) > 1 else ""))
    return sorted(facts)


def apply_declaration(mcp, host, name, subtree):
    """Declare one generated crate through the bridge (the same call the CLI makes)."""
    result = mcp.tool("xirang.crates", host, action="declare", crate=name,
                      subtree=subtree, apply=True)
    if result["isError"]:
        fail("crates declare failed:\n%s" % result["text"])


def collision_leg(work, cli, mcp_binary):
    """Two declarations whose identity inputs coincide must be refused, not silently merged.

    两条身份输入重合的声明必须被拒绝，而不是静默合并。
    """
    print("== leg collision (same record spelling, same kind, two files)")
    host = new_host(work / "collision", cli, custom_lib=False)
    mcp = MCP(mcp_binary, host)
    try:
        apply(mcp, host, action="add", apply=True,
              fields={"module": "panel", "kind": "Panel", "needs_registry": True})
        apply(mcp, host, action="add", apply=True, parent="root/panel",
              file="components/reading/reading.rs",
              fields={"module": "reading", "kind": "Reading"})
        # `src/components/reading/reading.rs` has the **same record spelling**
        # (`components/reading/reading.rs`) and the same kind, so its identity is the island's: the
        # tool must refuse the second declaration instead of mounting one identity twice.
        # `src/components/reading/reading.rs` 的记录拼写与 kind 都与孤岛相同，因此身份也相同：工具必须
        # 拒绝第二条声明，而不是把同一个身份挂两遍。
        ok, text = attempt(mcp, host, action="add", apply=True, parent="root",
                           file="src/components/reading/reading.rs",
                           fields={"module": "reading", "kind": "Reading"})
        if not ok and ("duplicate" in text.lower() or "already" in text.lower()):
            print("   second declaration refused by identity/path collision")
        else:
            fail("collision: the second declaration was not refused as a duplicate:\n%s" % text)
    finally:
        mcp.close()


